{
  "name": "tokenwise-cli",
  "version": "0.3.0",
  "description": "The efficiency layer for AI coding spend. Rank yourself by value shipped per dollar — not tokens burned. Open-source CLI; only anonymized aggregates ever leave your machine.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "tokenwise": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "ai",
    "claude-code",
    "codex",
    "cost",
    "tokens",
    "efficiency",
    "cli",
    "leaderboard"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
